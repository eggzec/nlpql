!    -*- f90 -*-
!
!    f2py signature file of the NLPQL package.
!
!    All array dimensions are hidden and deduced from the shapes of the
!    arrays that are passed in, so that the Python signatures keep the
!    argument order of the Fortran routines.  Every array which carries
!    internal state from one call to the next is declared intent(in,out),
!    because the codes communicate with the calling program by reverse
!    communication.
!
python module _nlpql
    interface

        subroutine nlpqlpq(np,m,me,mmax,n,nmax,mnn2,x,f,g,df,dg,u,xl,xu,c,d,acc,accqp,stpmin,maxfun,maxit,maxnm,rho,iprint,mode,iout,ifail,wa,lwa,kwa,lkwa,act,lact,lql)
            integer intent(hide),depend(x) :: np=shape(x,1)
            integer intent(in) :: m
            integer intent(in) :: me
            integer intent(hide),depend(g) :: mmax=shape(g,0)
            integer intent(in) :: n
            integer intent(hide),depend(x) :: nmax=shape(x,0)
            integer intent(hide),depend(u) :: mnn2=len(u)
            double precision dimension(nmax,np),intent(in,out) :: x
            double precision dimension(np),intent(in,out),depend(np) :: f
            double precision dimension(mmax,np),intent(in,out) :: g
            double precision dimension(nmax),intent(in,out),depend(nmax) :: df
            double precision dimension(mmax,nmax),intent(in,out),depend(mmax,nmax) :: dg
            double precision dimension(mnn2),intent(in,out) :: u
            double precision dimension(nmax),intent(in),depend(nmax) :: xl
            double precision dimension(nmax),intent(in),depend(nmax) :: xu
            double precision dimension(nmax,nmax),intent(in,out),depend(nmax) :: c
            double precision dimension(nmax),intent(in,out),depend(nmax) :: d
            double precision intent(in) :: acc
            double precision intent(in) :: accqp
            double precision intent(in) :: stpmin
            integer intent(in) :: maxfun
            integer intent(in) :: maxit
            integer intent(in) :: maxnm
            double precision intent(in) :: rho
            integer intent(in) :: iprint
            integer intent(in) :: mode
            integer intent(in) :: iout
            integer intent(in,out) :: ifail
            double precision dimension(lwa),intent(in,out) :: wa
            integer intent(hide),depend(wa) :: lwa=len(wa)
            integer dimension(lkwa),intent(in,out) :: kwa
            integer intent(hide),depend(kwa) :: lkwa=len(kwa)
            logical dimension(lact),intent(in,out) :: act
            integer intent(hide),depend(act) :: lact=len(act)
            logical intent(in) :: lql
        end subroutine nlpqlpq

